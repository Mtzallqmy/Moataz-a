BOT_TOKEN=
DATABASE_URL=

# Media Studio storage, delivery and enforced resource limits.
PROJECT_DIR=/data/projects
RENDER_TEMP_DIR=/data/tmp
MAX_FILE_SIZE_MB=512
MAX_VIDEO_DURATION_SECONDS=14400
TELEGRAM_UPLOAD_LIMIT_MB=49
MAX_PROJECT_ASSETS=20
MAX_PROJECT_DURATION_SECONDS=1800
MAX_RENDER_DURATION_SECONDS=1800
MAX_CONCURRENT_RENDERS=1
MAX_RENDERS_PER_USER=1
RENDER_TIMEOUT_SECONDS=1800
MAX_RENDER_RETRIES=1
DEFAULT_RENDER_FPS=30
PROGRESS_UPDATE_SECONDS=2.5

# yt-dlp authentication and egress. Prefer a mounted Netscape cookies.txt file.
# On Railway, YTDLP_COOKIES_B64 may contain the base64-encoded file instead.
# Never commit cookie contents or proxy credentials to the repository.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_B64=
# Optional ordered outbound proxies. Separate entries with commas or new lines.
YTDLP_PROXY_URLS=
YTDLP_IMPERSONATE=true

# Ordered self-hosted/authorized Cobalt API instances. Do not use
# api.cobalt.tools without explicit permission from its operator.
COBALT_API_URLS=
COBALT_API_TOKEN=
COBALT_AUTH_SCHEME=Api-Key
COBALT_TIMEOUT_SECONDS=45

# Optional gallery-dl CLI backend. The production Docker image installs the CLI,
# but routing remains disabled until this flag is enabled.
GALLERYDL_ENABLED=false
GALLERYDL_COOKIE_FILE=
GALLERYDL_TIMEOUT_SECONDS=180

# Optional Instagram specialist. Posts/Reels can work without a session;
# Stories require an authorized Instaloader session file.
INSTALOADER_ENABLED=false
INSTAGRAM_SESSION_FILE=

# Optional YouTube fallback after yt-dlp and Cobalt.
PYTUBEFIX_ENABLED=false

# Optional operator-controlled TikTok/Douyin sidecar. Disabled unless both the
# flag and URL are configured. Never point this at an untrusted public service.
TIKTOK_BACKEND_ENABLED=false
TIKTOK_BACKEND_URL=
TIKTOK_BACKEND_TOKEN=
TIKTOK_COOKIE_FILE=
TIKTOK_BACKEND_TIMEOUT_SECONDS=60

# Per-backend/per-platform circuit breaker.
DOWNLOAD_BACKEND_FAILURE_THRESHOLD=3
DOWNLOAD_BACKEND_COOLDOWN_SECONDS=120

# Backward-compatible single OpenAI-compatible provider.
OPENAI_BASE_URL=
OPENAI_API_TOKEN=
OPENAI_API_KEY=

# Convenience presets. Base URLs can be overridden, but these defaults are the
# official OpenAI-compatible API roots used by each provider.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_TOKEN=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_TOKEN=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_TOKEN=
RUNWARE_BASE_URL=https://api.runware.ai/v1
RUNWARE_API_TOKEN=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_TOKEN=
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_API_TOKEN=
XAI_BASE_URL=https://api.x.ai/v1
XAI_API_TOKEN=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_TOKEN=

# Unlimited custom/provider instances. Repeat with any unique ID, including
# multiple IDs pointing at the same vendor/base URL with different API tokens.
AI_PROVIDER_EXAMPLE_1_NAME=
AI_PROVIDER_EXAMPLE_1_BASE_URL=
AI_PROVIDER_EXAMPLE_1_API_TOKEN=
AI_PROVIDER_EXAMPLE_1_PRIORITY=100
