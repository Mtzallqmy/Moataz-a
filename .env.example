# Required on Railway / production
BOT_TOKEN=
DATABASE_URL=

# Everything below is optional.
# Default mode is polling, so no domain or webhook is required.
# APP_MODE=polling
# WEBHOOK_BASE_URL=
# WEBHOOK_SECRET=

# Optional access control.
# Leave both empty to allow anyone who knows the bot to use it.
# Set comma-separated numeric Telegram IDs to make the bot private.
# ADMIN_TELEGRAM_IDS=
# ALLOWED_TELEGRAM_IDS=

# Optional application settings
# APP_NAME=Moataz Media Bot
# WORKER_NAME=
# APP_HOST=0.0.0.0
# APP_PORT=8000
# PUBLIC_BASE_URL=
# DOWNLOAD_DIR=/data/downloads
# MAX_CONCURRENT_JOBS=2
# MAX_JOBS_PER_USER=1
# MAX_VIDEO_DURATION_SECONDS=14400
# MAX_FILE_SIZE_MB=512
# TELEGRAM_UPLOAD_LIMIT_MB=49
# AUTO_COMPRESS_ENABLED=true
# MEDIA_COMPRESSION_ATTEMPTS=2
# PROGRESS_UPDATE_SECONDS=2
# DEFAULT_LANGUAGE=ar

# Optional yt-dlp engine tuning (Phase 4)
# YTDLP_SOCKET_TIMEOUT_SECONDS=30
# YTDLP_RETRIES=2
# YTDLP_FRAGMENT_RETRIES=3
# YTDLP_CONCURRENT_FRAGMENTS=4

# Optional job retry settings
# JOB_MAX_RETRIES=2
# JOB_RETRY_BASE_SECONDS=5

# Optional dashboard settings
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=
# DASHBOARD_WS_TOKEN=

# Optional distributed queue. Not needed for a normal one-service deployment.
# QUEUE_BACKEND=inline
# REDIS_URL=

# Optional yt-dlp cookies file mounted inside the container
# YTDLP_COOKIES_FILE=
