# Telegram
BOT_TOKEN=123456:replace_me
APP_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=replace-with-a-long-random-string
TELEGRAM_LOCAL_API_URL=

# Access control (comma-separated Telegram numeric IDs). Configure at least one admin ID.
ADMIN_TELEGRAM_IDS=123456789
ALLOWED_TELEGRAM_IDS=123456789

# App
APP_NAME=Moataz Media Bot
WORKER_NAME=
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
DOWNLOAD_DIR=/data/downloads
MAX_CONCURRENT_JOBS=2
MAX_JOBS_PER_USER=1
MAX_VIDEO_DURATION_SECONDS=14400
MAX_FILE_SIZE_MB=1900
PROGRESS_UPDATE_SECONDS=2
DEFAULT_LANGUAGE=ar

# Dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-now
DASHBOARD_WS_TOKEN=change-me-too

# Data services
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/moataz
REDIS_URL=redis://redis:6379/0

# Optional yt-dlp cookies file mounted inside the container
YTDLP_COOKIES_FILE=
